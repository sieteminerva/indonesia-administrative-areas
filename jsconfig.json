{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noImplicitAny": false,
    "strictNullChecks": false
    // "noCheck": true
  },
  "include": ["src/**/*.js", "index.js", "vite.config.js"],
  "exclude": ["node_modules", "apps-script", "dist"]
}
